<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Deliberately minimal permissions. This launcher does NOT use:
        - an AccessibilityService (what banking apps block)
        - SYSTEM_ALERT_WINDOW / overlays
        - a NotificationListenerService
        - QUERY_ALL_PACKAGES
    -->
    <uses-permission android:name="android.permission.INTERNET" />            <!-- weather -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />       <!-- up next / agenda -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> <!-- optional: local weather -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" /> <!-- "Uninstall" menu item -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Optional, off unless you grant it: lets glass blur your system wallpaper (Android only
         shares the wallpaper image with apps that have "All files access"). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />    <!-- swipe down for the shade -->       <!-- optional "use as phone wallpaper" -->

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Panel">

        <!-- Ask Play services to fetch the on-device subject cut-out model at install time. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <!--
          Only used if the user opts in to "full music controls" by granting notification access
          (off by default). Panel never reads notifications; it just needs this to see media sessions.
        -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="Panel music controls"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
